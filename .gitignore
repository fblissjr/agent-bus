# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/

# Unshared notes, generated registers, scratch: never repo content.
internal/

# Harness state and per-user settings. Each harness may create its own
# directory in a workspace; none of it is repo content. The plugin manifests
# live in .claude-plugin/, plugin.json, and (later) .codex-plugin/, which are
# tracked.
.claude/
.gemini/
.antigravity/
.agents/
.codex/
/data/*
!/data/.gitkeep

# Safety net: SQLite + observability log files should never land in git
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal
