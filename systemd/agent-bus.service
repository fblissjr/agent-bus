[Unit]
Description=agent-bus daemon
After=network.target

# A system unit on purpose: every participant on the host runs as the owner's
# uid, so the store must be owned by a uid none of them have. DynamicUser gives
# one; StateDirectory gives it /var/lib/agent-bus for store.db, ledger.jsonl,
# threads/, admin.token, and PROTOCOL.md, and the daemon reads $STATE_DIRECTORY.
# Nothing in that directory is for other uids: the owner reads it through the
# API with the admin token, or with sudo.
#
# This file is installed by scripts/deploy-host.sh as a root-owned copy under
# /etc/systemd/system. Never enable it by a path into a checkout: root would
# then run a unit file that every agent on the host can edit.
[Service]
Type=simple
DynamicUser=yes
StateDirectory=agent-bus
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/agent-bus/bin/agent-bus-daemon
Restart=always
RestartSec=3

# The daemon needs the package under /opt, its state directory, and a loopback
# socket. Everything else is closed: no home directories, no devices, no
# kernel or cgroup tunables, no capabilities, no privilege escalation, no
# address family beyond IP and the local socket Python's runtime uses.
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
